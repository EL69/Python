class Horse:
  # Create a __init__ method
  def __init__(self, input_name, input_breed, input_age, input_color, input_domestication = True):

# Create a new pet!
    self.name = input_name
    self.breed = input_breed
    self.age = input_age
    self.color = input_color
    self.domestication = input_domestication


def __repr__(self):
  description = "This horse is named {name}, is of breed {breed} and is {age} years old. The horse is {color} in color, and is {domesticated}".format(name=self.name, breed=self.breed, age=self.age, domesticated=self.domestication)

  return description

horse_mine = Horse('Amadioha', 'Arabian', 7, 'Golden Brown')
  
print(horse_mine)